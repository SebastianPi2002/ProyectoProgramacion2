@model Dominio.Investigador

@{
    ViewData["Title"] = "Mi perfil";
}

<h2>Mi perfil</h2>

<div class="card mt-4">
    <div class="card-body">

        <h4>Datos del investigador</h4>

        <hr />

        <p>
            <strong>Nombre:</strong>
            @Model.Nombre
        </p>

        <p>
            <strong>Email:</strong>
            @Model.Email
        </p>

        <p>
            <strong>Rol:</strong>
            @Model.Rol
        </p>

        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-primary">
            Volver al inicio
        </a>

    </div>
</div>
