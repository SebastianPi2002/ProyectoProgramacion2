
@model List<Dominio.Caso>

@{
    ViewData["Title"] = "Listado de casos";
}

<h1 class="mb-4">Listado de casos</h1>

<a asp-controller="Casos"
   asp-action="Crear"
   class="btn btn-success mb-4">
    Crear nuevo caso
</a>

<div class="table-responsive">
    <table class="table table-dark table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Descripción</th>
                <th>Investigador</th>
                <th>Acciones</th>
            </tr>
        </thead>

        <tbody>
            @foreach (Dominio.Caso caso in Model)
            {
                <tr>
                    <td>@caso.Nombre</td>
                    <td>@caso.Descripcion</td>
                    <td>@caso.Investigador.Nombre</td>
                    <td>
                        <a asp-controller="Casos"
                           asp-action="Detalles"
                           asp-route-id="@caso.Id"
                           class="btn btn-primary btn-sm">
                            Ver detalles
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
