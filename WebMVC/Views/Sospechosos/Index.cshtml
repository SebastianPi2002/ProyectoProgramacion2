@model List<Dominio.Sospechoso>

@{
    ViewData["Title"] = "Sospechosos";
}

<h2>Listado de sospechosos</h2>

<form asp-controller="Sospechosos"
      asp-action="Index"
      method="get"
      class="mb-4">

    <label>Edad mínima</label>

    <input type="number"
           name="edadMinima"
           min="0"
           value="@ViewBag.EdadMinima"
           class="form-control mb-2" />

    <button type="submit"
            class="btn btn-primary">
        Filtrar
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Limpiar
    </a>
</form>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}

@if (Model.Count == 0)
{
    <p>No se encontraron sospechosos.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Cédula</th>
                <th>Edad</th>
                <th>Antecedentes</th>
            </tr>
        </thead>
        <tbody>
            @foreach (Dominio.Sospechoso sospechoso in Model)
            {
                <tr>
                    <td>@sospechoso.Nombre</td>
                    <td>@sospechoso.Cedula</td>
                    <td>@sospechoso.CalcularEdad()</td>
                    <td>
                        @(sospechoso.Antecedentes ? "Sí" : "No")
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
